// ---- ADJUST STOCK ----
document.querySelectorAll('.adjust-stock-btn').forEach(btn => {
    btn.addEventListener('click', function () {
        const row = this.closest('tr');
        if (row) {
            const product = row.querySelector('td:nth-child(2)')?.textContent?.trim() || '';
            const currentStock = row.querySelector('td:nth-child(4)')?.textContent?.trim() || '0';
            const modal = document.querySelector('#adjustStockModal');
            const select = modal?.querySelector('#stockProduct');

            if (select) {
                for (let option of select.options) {
                    if (option.text === product) { select.value = option.value; break; }
                }
            }

            const qtyInput = modal?.querySelector('#adjustmentQty');
            if (qtyInput) {
                qtyInput.placeholder = `Current stock: ${currentStock}`;
                qtyInput.value = '';
            }
            const reason = modal?.querySelector('#adjustmentReason');
            if (reason) reason.value = '';
        }
    });
});

// ---- UPDATE STOCK ----
document.getElementById('updateStockBtn')?.addEventListener('click', function () {
    const product = document.getElementById('stockProduct').value;
    const type = document.getElementById('adjustmentType').value;
    const qty = document.getElementById('adjustmentQty').value;
    const reason = document.getElementById('adjustmentReason').value;

    if (!product) { showAlert('Please select a product', 'warning'); return; }
    if (!qty || qty <= 0) { showAlert('Please enter a valid quantity', 'warning'); return; }

    const rows = document.querySelectorAll('#stockTableBody tr');
    let updated = false;

    rows.forEach(row => {
        const rowProduct = row.querySelector('td:nth-child(2)')?.textContent?.trim() || '';
        if (rowProduct === product) {
            const stockCell = row.querySelector('td:nth-child(4)');
            const currentStock = parseInt(stockCell?.textContent || 0);
            let newStock = currentStock;

            if (type === 'Add Stock') newStock = currentStock + parseInt(qty);
            else if (type === 'Remove Stock') newStock = Math.max(0, currentStock - parseInt(qty));
            else if (type === 'Set Quantity') newStock = parseInt(qty);

            stockCell.textContent = newStock;
            stockCell.style.color = newStock > 20 ? '#10B981' : (newStock > 0 ? '#F59E0B' : '#EF4444');

            const statusCell = row.querySelector('td:nth-child(7)');
            let statusText = 'In Stock';
            let badgeClass = 'success';
            if (newStock <= 0) { statusText = 'Out of Stock'; badgeClass = 'danger'; }
            else if (newStock <= 20) { statusText = 'Low Stock'; badgeClass = 'warning'; }

            statusCell.innerHTML = `<span class="badge bg-${badgeClass}${badgeClass === 'warning' ? ' text-dark' : ''}" style="padding: 5px 12px; border-radius: 20px;">${statusText}</span>`;

            addMovement(product, type, newStock - currentStock, reason);
            updated = true;
            showAlert(`Stock for "${product}" updated successfully!`, 'success');
            bootstrap.Modal.getInstance(document.getElementById('adjustStockModal')).hide();
            document.getElementById('adjustStockForm').reset();
        }
    });

    if (!updated) showAlert('Product not found', 'danger');
});

// ---- ADD MOVEMENT HISTORY ----
function addMovement(product, type, qtyChange, reason) {
    const tbody = document.getElementById('movementTableBody');
    const now = new Date();
    const dateStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0') + ' ' + String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');

    let badgeClass = 'success';
    let typeLabel = type;
    let qtyDisplay = '+' + qtyChange;
    if (type === 'Remove Stock') { badgeClass = 'danger'; qtyDisplay = qtyChange; }
    else if (type === 'Set Quantity') { badgeClass = 'warning'; qtyDisplay = qtyChange; }

    const newRow = document.createElement('tr');
    newRow.innerHTML = `
        <td style="padding: 10px 15px;">${dateStr}</td>
        <td style="padding: 10px 15px;"><strong>${product}</strong></td>
        <td style="padding: 10px 15px;"><span class="badge bg-${badgeClass}${badgeClass === 'warning' ? ' text-dark' : ''}">${typeLabel}</span></td>
        <td style="padding: 10px 15px;">${qtyDisplay}</td>
        <td style="padding: 10px 15px;">Admin</td>
        <td style="padding: 10px 15px;">${reason || 'Stock adjustment'}</td>
    `;
    tbody.prepend(newRow);
}

