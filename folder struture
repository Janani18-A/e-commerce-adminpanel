// Override saveSubModal to handle callbacks
const originalSaveSubModal = saveSubModal;
saveSubModal = function () {
    const modal = document.getElementById('subModal');
    const callback = modal.dataset.callback;
    if (callback && typeof window[callback] === 'function') {
        window[callback]();
    } else {
        originalSaveSubModal();
    }
};

