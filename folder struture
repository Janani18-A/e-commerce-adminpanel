// ---- COPY COUPON CODE ----
document.addEventListener('click', function (e) {
    if (e.target.closest('.discount-code i.fa-copy')) {
        const icon = e.target.closest('.discount-code i.fa-copy');
        const codeText = icon.closest('.discount-code').textContent.trim().replace('Copy code', '').trim();
        if (navigator.clipboard) {
            navigator.clipboard.writeText(codeText).then(() => showCopyFeedback(icon)).catch(() => fallbackCopy(codeText, icon));
        } else {
            fallbackCopy(codeText, icon);
        }
    }
});

function showCopyFeedback(element) {
    const originalClass = element.className;
    element.className = 'fas fa-check';
    element.style.color = '#10B981';
    setTimeout(() => { element.className = originalClass; element.style.color = ''; }, 1500);
}

function fallbackCopy(text, element) {
    const input = document.createElement('input');
    input.value = text;
    document.body.appendChild(input);
    input.select();
    document.execCommand('copy');
    document.body.removeChild(input);
    showCopyFeedback(element);
}

