function updatePaginationInfo() {
    const tables = [
        { id: 'productTableBody', info: document.getElementById('paginationInfo') },
        { id: 'categoryTableBody', info: document.getElementById('categoryPaginationInfo') },
        { id: 'discountTableBody', info: document.getElementById('discountPaginationInfo') }
    ];

    tables.forEach(({ id, info }) => {
        if (info) {
            const tbody = document.getElementById(id);
            if (tbody) {
                const visibleRows = tbody.querySelectorAll('tr:not([style*="display: none"])');
                const totalRows = tbody.querySelectorAll('tr').length;
                const start = visibleRows.length > 0 ? 1 : 0;
                const end = visibleRows.length;
                info.textContent = `Showing ${start} to ${end} of ${totalRows} entries`;
            }
        }
    });
}

// ---- ALERT SYSTEM ----
function showAlert(message, type = 'info') {
    const existing = document.querySelectorAll('.custom-alert');
    existing.forEach(el => el.remove());

    const alertDiv = document.createElement('div');
    alertDiv.className = `custom-alert alert alert-${type} alert-dismissible fade show position-fixed`;
    alertDiv.style.cssText = `
        top: 80px;
        right: 20px;
        z-index: 9999;
        min-width: 300px;
        max-width: 500px;
        border-radius: 0.75rem;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
        animation: slideIn 0.3s ease-out;
        background: #FFFFFF;
        border-left: 4px solid ${type === 'success' ? '#10B981' : type === 'danger' ? '#EF4444' : type === 'warning' ? '#F59E0B' : '#2563EB'};
    `;

    alertDiv.innerHTML = `<strong>${message}</strong> <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    document.body.appendChild(alertDiv);

    setTimeout(() => {
        if (alertDiv.parentNode) {
            alertDiv.classList.remove('show');
            setTimeout(() => alertDiv.remove(), 300);
        }
    }, 4000);
}

