RewriteEngine On

# Skip rewriting for ajax folder (important!)
RewriteRule ^ajax/ - [L]

# Remove .php extension for root files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# Handle auth folder properly
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^auth/([^/]+)/?$ auth/$1.php [L]

# Redirect .php URLs to extensionless URLs (skip ajax folder)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
RewriteCond %{REQUEST_URI} !^/ajax/ [NC]
RewriteRule ^ /%1 [R=301,L]

# Handle root URL
RewriteRule ^$ index.php [L]